# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Database (mysql2)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=inventory_app
DB_PASSWORD=replace-with-a-real-password
DB_NAME=inventory_db

# AWS
# Region must match every resource (RDS, EC2, S3) — eu-west-1 per the build plan.
AWS_REGION=eu-west-1
S3_BUCKET=your-inventory-bucket-name

# Local development only: the EC2 instance role supplies credentials in
# production, so these are never set on the server.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
